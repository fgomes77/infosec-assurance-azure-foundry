# Copy to .env and fill in. Authentication is Entra ID via DefaultAzureCredential
# (az login) — no API keys are stored anywhere in this repo.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-infosec-foundry

# Filled in after provision.sh prints it:
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployments created by the Bicep template:
MODEL_DEPLOYMENT_NAME=gpt-4o
REASONING_MODEL_DEPLOYMENT_NAME=o3-mini
