# Copy to .env and fill in. Authentication is Entra ID via DefaultAzureCredential
# (az login) — no API keys are stored anywhere in this repo.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-infosec-foundry

# Filled in after provision.sh prints it:
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployments created by the Bicep template (tiers: governance/MODEL_ROUTING.md):
MODEL_DEPLOYMENT_NAME=gpt-4o
# Finding C4: NOT o3-mini - it supports none of the OpenAPI, MCP, Azure AI
# Search, SharePoint or Web Search tools that every reasoning agent carries.
# Tool-capable reasoning model of record (EU Data Zone); alternate gpt-5-mini.
# Matrix of record: integrations/registry.json model_tiers._tool_compatibility
REASONING_MODEL_DEPLOYMENT_NAME=o4-mini
LIGHT_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# --- Delivery layer (REQUIREMENTS.md) -------------------------------------
# SharePoint InfoSec Assurance site (sharepoint/README.md):
SHAREPOINT_SITE_ID=<tenant>.sharepoint.com,<site-guid>,<web-guid>
SHAREPOINT_REPORTS_DRIVE_ID=<drive-id-of-reports-library>
SHAREPOINT_REPORTS_ROOT_ITEM_ID=<item-id-of-Reports-folder>
SHAREPOINT_DPO_ROOT_ITEM_ID=<item-id-of-Reports-DPO-folder>
SHAREPOINT_ADVISORY_ROOT_ITEM_ID=<item-id-of-Advisory-folder>
SHAREPOINT_TEMPLATES_REVIEWS_ITEM_ID=<item-id-of-Templates-Reviews-folder>
SHAREPOINT_TPA_ACTIVE_PATH=Infosec Assurance/GRC/TPA/Active
# Delta re-analysis for requirement d2 (sharepoint/README.md): the facts a
# previously APPROVED run extracted from each evidence file, keyed on the
# file's Graph eTag. A reassessment then reads only what changed. Nothing
# time-dependent is cached: VALID / EXPIRING / EXPIRED are recomputed at
# every report date. Entries older than the cap are re-read, so a silent
# mis-extraction cannot live in the register forever.
EVIDENCE_CACHE_LIST_NAME=TPA Evidence Cache
EVIDENCE_CACHE_MAX_AGE_DAYS=180

# Purview sensitivity label assigned to every delivered report of record
# (finding C16; workflows/pipelines.json shared.sensitivityLabel ->
# report-delivery-pipeline sensitivityLabelId). Empty = library default label.
# A per-report-type override comes from templates/registry.json `sensitivity_label`.
SHAREPOINT_SENSITIVITY_LABEL_ID=<purview-sensitivity-label-guid>
# All of the above are printed by: scripts/sharepoint_bootstrap.py --site-url ... --function-app-id ...

# --- Foundry data-plane runtime (enterprise/series/06 §A; finding C1) -----
# Pinned wire version for BOTH the scripts and the Logic Apps app setting of
# the same name. v1 = GA agents / conversations / responses.
# Documented fallback: 2025-05-01 is the classic threads/runs surface, which
# retires 2027-03-31; scripts/_foundry_runtime.py takes it automatically when
# only azure-ai-projects 1.x is installed and deploy.sh [0b] warns about it.
FOUNDRY_API_VERSION=v1
# FOUNDRY_RUNTIME=responses        # force responses|classic (default: from the SDK)
# STRICT_RUNTIME=1                 # deploy.sh [0b] fails instead of warning
# ENABLE_A2A_TOOL=false            # attach the A2A tool (preview) alongside the ROUTE table

# --- Knowledge and memory sources (finding C3) ----------------------------
# ONE vector store per agent is a fixed service limit, so combined knowledge
# and durable memory cannot be a second file_search store.
#   KNOWLEDGE_SOURCE=vector-store  advisory agents keep their own vs-<agent>;
#                                  cross-framework questions ROUTE to the
#                                  advisor, which holds vs-assurance-combined
#   KNOWLEDGE_SOURCE=ai-search     combined knowledge from the Azure AI Search
#                                  / Foundry IQ index below (target state)
#   KNOWLEDGE_SOURCE=none          no combined grounding
KNOWLEDGE_SOURCE=vector-store
MEMORY_BACKEND=vector-store        # vector-store | search-index (enterprise/MEMORY_AND_LEARNING.md §2)
SEARCH_SERVICE_ENDPOINT=
SEARCH_CONNECTION_NAME=ai-search   # project connection, category CognitiveSearch
KNOWLEDGE_INDEX_NAME=kb-assurance   # alias accepted: KNOWLEDGE_BASE_NAME
MEMORY_INDEX_NAME=kb-assurance-memory

# --- Scheduled follow-ups (mcp-server schedule_followup) ------------------
# Trigger URL of the scheduled-followup Logic App, INCLUDING its shared
# access signature - a secret: keep it in Key Vault and inject it, never
# commit a real value. Contract: integrations/openapi/followup-scheduler.yaml.
# Absent, the MCP tool reports that nothing was scheduled.
# FOLLOWUP_SCHEDULER_URL=https://{baseName}-la.azurewebsites.net/api/scheduled-followup/triggers/Followup_requested/invoke?api-version=2022-05-01&sp={sp}&sv=1.0&sig={sig}
MEMORY_AUTHOR_UPN=                 # UPN written into memory notes and used as requestedBy

# --- Retention horizons (scripts/cleanup_foundry.py) ----------------------
# Single source of the retention control: governance/MEMORY_POLICY.md §3 and
# enterprise/MEMORY_AND_LEARNING.md §1 (M1 conversations, M2 team notes).
# cleanup_foundry.py reads ONLY these values - it holds no hard-coded horizon.
RETENTION_CONVERSATION_APPROVED_DAYS=90   # M1: after the deliverable is approved and stored
RETENTION_CONVERSATION_IDLE_DAYS=180      # M1: inactivity (classic threads; GA conversations use the Cosmos DB TTL)
RETENTION_ORPHAN_FILE_DAYS=30             # grace before an unreferenced assistants file is removed
RETENTION_ORPHAN_STORE_DAYS=30            # grace before an orphan vs-* store is removed
RETENTION_MEMORY_MONTHS=24                # M2: retain_until cap on durable team notes

# --- ENX internal gateway MCP (finding C10) -------------------------------
# Read by integrations/connections/create_connections.sh and
# integrations/connections/connections.bicep. The bearer lives ONLY in Key
# Vault behind the project connection conn-enx-gateway - never in a run-time
# header, a workflow body or this file. Name of the secret, never its value.
ENX_GATEWAY_MCP_URL=https://{enx-gateway-host}/mcp
KV_SECRET_ENX_GATEWAY=enx-gateway-token

# Delivery Function App (functions/delivery/):
DELIVERY_FUNCTION_BASE_URL=https://<delivery-function>.azurewebsites.net/api
DELIVERY_FUNCTION_APP_NAME=<delivery-function>          # deploy.sh --functions
# function key lives in Key Vault; Logic Apps reference it there, never here

# --- Release tag stamped on every agent (operations/LIFECYCLE.md) ---------
# KIT_RELEASE=platform/1.0.0        # default: git describe --tags --match 'platform/*'

# --- Team / identity (team/TEAM_MODEL.md) ---
KEY_VAULT_NAME=<baseName>-kv
ENTRA_GROUP_USERS_OBJECT_ID={objectId:sg-infosec-foundry-users}
ENTRA_GROUP_REPORT_APPROVERS_OBJECT_ID={objectId:sg-infosec-foundry-report-approvers}
ENTRA_GROUP_SENIOR_APPROVERS_OBJECT_ID={objectId:sg-infosec-foundry-senior-approvers}
ENTRA_GROUP_OWNER_OBJECT_ID={objectId:sg-infosec-foundry-owner}
ENTRA_GROUP_ADMIN_PIM_OBJECT_ID={objectId:sg-infosec-foundry-admin-pim}
PLATFORM_OWNER_UPN={upn:francisco.gomes}
DEPUTY_APPROVER_UPN={upn:deputy-approver}
APPROVAL_POLICY_PATH=../team/approval-policy.json

# --- Operations (operations/MONITORING.md) ---
LOG_ANALYTICS_WORKSPACE_NAME=<baseName>-logs
FOUNDRY_ACCOUNT_NAME=<baseName>-aif
APP_INSIGHTS_NAME=<baseName>-appi
BASE_NAME=<baseName>
OWNER_ALERT_EMAIL={email:sg-infosec-foundry-owner}
ACTION_GROUP_ID=
BUDGET_START_DATE={yyyy-MM-01}
# Webhook targets are Key Vault secret NAMES, never URLs (a Teams webhook URL
# is a bearer credential: anyone holding it can post as the platform).
TEAMS_PLATFORM_CHANNEL_WEBHOOK_SECRET_NAME=teams-platform-webhook
SOC_ONCALL_WEBHOOK_SECRET_NAME=soc-oncall-webhook
# Per-agent daily ceiling read by operations/kql/latency-and-tokens.kql; a
# breach is a tier-tuning signal, not an outage (MODEL_ROUTING.md rule 7).
DAILY_TOKEN_BUDGET=20000000

# --- FinOps (operations/FINOPS.md) ---
# Monthly ceilings the budget alerts in infra/cost.bicep key on.
MODEL_BUDGET_EUR=300
OBSERVABILITY_BUDGET_EUR=300
# EUR per 1M tokens. Placeholders — align with the current price list AND with
# integrations/registry.json model_tiers._deployment_of_record: a price map
# that names a model the platform does not run prices that tier at zero.
# Read by operations/evaluation/run_evals.py and mirrored in
# operations/kql/latency-and-tokens.kql.
PRICE_EUR_PER_1M_IN=gpt-4o-mini:0.15,gpt-4o:2.50,o4-mini:1.10
PRICE_EUR_PER_1M_OUT=gpt-4o-mini:0.60,gpt-4o:10.00,o4-mini:4.40

# --- Observability cost shape (infra/main.bicep) --------------------------
# Interactive (queryable) retention; everything up to logRetentionDays (365,
# the DORA Art. 28 evidence horizon) is held in the archive tier at roughly a
# tenth of the cost. 90 days covers every shipped query (longest lookback 30
# days). Values of record live in infra/main.parameters*.json — this is the
# reader's copy.
LOG_INTERACTIVE_RETENTION_DAYS=90
LOG_RETENTION_DAYS=365

# --- Backup / DR (operations/BACKUP_DR.md) ---
BACKUP_OUT_DIR=../operations/backups
BACKUP_STORAGE_ACCOUNT=<baseName>sa
BACKUP_CONTAINER=backups

# --- Platform resources (enterprise/ENTERPRISE_BLUEPRINT.md) --------------
COSMOS_ACCOUNT_NAME={baseName}-cosmos            # standard agent setup - conversations + agent definitions (finding C5)
SEARCH_SERVICE_NAME={baseName}-search            # standard agent setup - vector stores / knowledge base
AGENT_EGRESS_SUBNET_ID=                          # output agentEgressSubnetId of infra/main.bicep (finding C12)
CMK_KEY_URI=                                     # versionless Key Vault key URI, set on deployment pass 2 (finding C22)
