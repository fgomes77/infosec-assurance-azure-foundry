{
  "_comment": "Replaces Claude Code Remote send_later / run_once_at Routines: schedule a one-shot follow-up that re-opens an EXISTING Foundry conversation (e.g. 're-check supplier remediation in 30 days'). Read-only outcome: the agent answers in the conversation and the owner is notified on Teams; nothing is written to any system of record (documented exception in governance/HUMAN_APPROVAL.md: scheduling a run is not a submission). Exposed to agents via integrations/openapi/followup-scheduler.yaml / MCP schedule_followup.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "foundryEndpoint": {
        "type": "string",
        "defaultValue": "https://{foundry-account}.services.ai.azure.com/api/projects/{project-name}"
      },
      "apiVersion": {
        "type": "string",
        "defaultValue": "v1",
        "_comment": "GA agents / conversations / responses data plane (finding C1; the classic thread/run REST retires 2027-03-31). Bind to the FOUNDRY_API_VERSION app setting (setup/.env) so scripts and workflows pin the same version."
      },
      "teamsWebhookUrl": {
        "type": "securestring",
        "defaultValue": "{teams-incoming-webhook-url}"
      }
    },
    "triggers": {
      "Followup_requested": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "required": [
              "conversationId",
              "agentRef",
              "fireAt",
              "prompt",
              "requestedBy"
            ],
            "properties": {
              "conversationId": {
                "type": "string",
                "description": "Foundry conversation of the engagement (the conversations/responses runtime replaced the classic thread object, finding C1); `threadId` is accepted for one release."
              },
              "threadId": {
                "type": "string",
                "description": "Deprecated alias of conversationId."
              },
              "agentRef": {
                "type": "string",
                "description": "`<agent-name>:<version>` of the agent to run (build/agent-versions.json `ref`, finding C19); a bare name runs the latest version."
              },
              "fireAt": {
                "type": "string",
                "description": "RFC3339 UTC timestamp, max 90 days ahead (Logic Apps Wait limit)"
              },
              "prompt": {
                "type": "string"
              },
              "requestedBy": {
                "type": "string",
                "description": "UPN of the requesting team member (from the caller's token, not free text)"
              }
            }
          }
        }
      }
    },
    "actions": {
      "Respond_scheduled": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 202,
          "body": {
            "followupId": "@{workflow().run.name}",
            "fireAt": "@{triggerBody()?['fireAt']}"
          }
        },
        "runAfter": {}
      },
      "Delay_until_fireAt": {
        "type": "Wait",
        "inputs": {
          "until": {
            "timestamp": "@{triggerBody()?['fireAt']}"
          }
        },
        "runAfter": {
          "Respond_scheduled": [
            "Succeeded"
          ]
        }
      },
      "Run_followup_response": {
        "_comment": "Re-opens the SAME Foundry conversation (engagement context is preserved) - the Claude 'fire into an existing session' semantics. One Responses call replaces the classic post-message + create-run pair (finding C1).",
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses?api-version=@{parameters('apiVersion')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          },
          "body": {
            "conversation": "@{coalesce(triggerBody()?['conversationId'], triggerBody()?['threadId'])}",
            "agent_reference": "@if(contains(triggerBody()?['agentRef'], ':'), createObject('type','agent_reference','name', first(split(triggerBody()?['agentRef'], ':')), 'version', last(split(triggerBody()?['agentRef'], ':'))), createObject('type','agent_reference','name', triggerBody()?['agentRef']))",
            "input": "[Scheduled follow-up requested by @{triggerBody()?['requestedBy']} on @{utcNow()}] @{triggerBody()?['prompt']}",
            "background": true
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {
          "Delay_until_fireAt": [
            "Succeeded"
          ]
        }
      },
      "Until_run_completes": {
        "type": "Until",
        "expression": "@contains(createArray('completed','failed','incomplete','cancelled'), body('Get_run_status')?['status'])",
        "limit": {
          "count": 60,
          "timeout": "PT1H"
        },
        "runAfter": {
          "Run_followup_response": [
            "Succeeded"
          ]
        },
        "actions": {
          "Delay_Get_run_status": {
            "type": "Wait",
            "inputs": {
              "interval": {
                "count": 15,
                "unit": "Second"
              }
            },
            "runAfter": {}
          },
          "Get_run_status": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses/@{body('Run_followup_response')?['id']}?api-version=@{parameters('apiVersion')}",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://ai.azure.com"
              }
            },
            "runAfter": {
              "Delay_Get_run_status": [
                "Succeeded"
              ]
            }
          }
        }
      },
      "Get_answer": {
        "_comment": "Final read of the response object; the answer is `output_text`.",
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses/@{body('Run_followup_response')?['id']}?api-version=@{parameters('apiVersion')}",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          }
        },
        "runAfter": {
          "Until_run_completes": [
            "Succeeded"
          ]
        }
      },
      "Notify_owner": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@parameters('teamsWebhookUrl')",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "text": "⏰ Follow-up for @{triggerBody()?['requestedBy']} (conversation @{coalesce(triggerBody()?['conversationId'], triggerBody()?['threadId'])}): @{triggerBody()?['prompt']}\n\n@{coalesce(body('Get_answer')?['output_text'], last(body('Get_answer')?['output'])?['content'][0]?['text'], '')}\n\nNo submission of record was made - continue in the conversation; any write still goes through a report/ticket pipeline with approval."
          }
        },
        "runAfter": {
          "Get_answer": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}