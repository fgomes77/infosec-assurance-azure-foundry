{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "foundryEndpoint": {
        "type": "string",
        "defaultValue": "https://{foundry-account}.services.ai.azure.com/api/projects/{project-name}"
      },
      "apiVersion": { "type": "string", "defaultValue": "{foundry-api-version}" },
      "cyberForumAgentId": { "type": "string", "defaultValue": "{cyber-forum-agent-id}" },
      "jiraBaseUrl": { "type": "string", "defaultValue": "https://{jira-tenant}.atlassian.net" },
      "jiraAuthHeader": { "type": "securestring", "defaultValue": "Basic {jira-basic-auth-from-key-vault}" },
      "jiraProjectKey": { "type": "string", "defaultValue": "{jira-project-key}" },
      "approvalWebhookUrl": { "type": "securestring", "defaultValue": "" }
    },
    "triggers": {
      "Defender_incident_webhook": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "incidentId": { "type": "string" },
              "title": { "type": "string" },
              "severity": { "type": "string" },
              "alerts": { "type": "array" }
            }
          }
        }
      }
    },
    "actions": {
      "Run_cyber_forum_agent_on_incident": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('foundryEndpoint')}/threads/runs",
          "queries": { "api-version": "@parameters('apiVersion')" },
          "headers": { "Content-Type": "application/json" },
          "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" },
          "body": {
            "assistant_id": "@parameters('cyberForumAgentId')",
            "thread": {
              "messages": [
                {
                  "role": "user",
                  "content": "Produce a concise incident brief (impact, likely TTPs, affected third parties if any, recommended next actions) for this Defender/Sentinel incident JSON: @{string(triggerBody())}"
                }
              ]
            }
          }
        },
        "runAfter": {}
      },
      "Wait_until_brief_run_completes": {
        "type": "Until",
        "expression": "@not(equals(body('Poll_brief_run_status')?['status'], 'in_progress'))",
        "limit": { "count": 30, "timeout": "PT10M" },
        "runAfter": { "Run_cyber_forum_agent_on_incident": [ "Succeeded" ] },
        "actions": {
          "Delay_before_poll": {
            "type": "Wait",
            "inputs": { "interval": { "count": 10, "unit": "Second" } },
            "runAfter": {}
          },
          "Poll_brief_run_status": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{parameters('foundryEndpoint')}/threads/@{body('Run_cyber_forum_agent_on_incident')?['thread_id']}/runs/@{body('Run_cyber_forum_agent_on_incident')?['id']}",
              "queries": { "api-version": "@parameters('apiVersion')" },
              "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
            },
            "runAfter": { "Delay_before_poll": [ "Succeeded" ] }
          }
        }
      },
      "Get_incident_brief_message": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('foundryEndpoint')}/threads/@{body('Run_cyber_forum_agent_on_incident')?['thread_id']}/messages",
          "queries": { "api-version": "@parameters('apiVersion')", "order": "desc", "limit": "1" },
          "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
        },
        "runAfter": { "Wait_until_brief_run_completes": [ "Succeeded" ] }
      },
      "Respond_200_to_webhook_caller": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "status": "brief_pending_approval",
            "correlationId": "@{workflow().run.name}"
          }
        },
        "runAfter": { "Get_incident_brief_message": [ "Succeeded" ] }
      },
      "Send_approval_request_jira_incident_issue": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@parameters('approvalWebhookUrl')",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "subject": "Jira issue creation for incident @{triggerBody()?['incidentId']} (@{triggerBody()?['title']}, severity @{triggerBody()?['severity']})",
            "targetSystem": "Jira project @{parameters('jiraProjectKey')}",
            "draft": "@{first(body('Get_incident_brief_message')?['data'])?['content']?[0]?['text']?['value']}",
            "correlationId": "@{workflow().run.name}",
            "callback": "Approve or reject via the callback URL registered by the Wait_for_approval_jira_incident_issue step of this run."
          }
        },
        "runAfter": { "Respond_200_to_webhook_caller": [ "Succeeded" ] }
      },
      "Wait_for_approval_jira_incident_issue": {
        "type": "HttpWebhook",
        "inputs": {
          "subscribe": {
            "method": "POST",
            "uri": "@parameters('approvalWebhookUrl')",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "callbackUrl": "@{listCallbackUrl()}",
              "correlationId": "@{workflow().run.name}",
              "instruction": "POST {\"decision\":\"approved\"|\"rejected\",\"approver\":\"<upn>\"} to callbackUrl"
            }
          },
          "unsubscribe": {}
        },
        "limit": { "timeout": "P3D" },
        "runAfter": { "Send_approval_request_jira_incident_issue": [ "Succeeded" ] }
      },
      "Check_approval_decision_jira_incident_issue": {
        "type": "If",
        "expression": { "and": [ { "equals": [ "@body('Wait_for_approval_jira_incident_issue')?['decision']", "approved" ] } ] },
        "runAfter": { "Wait_for_approval_jira_incident_issue": [ "Succeeded" ] },
        "actions": {
          "Create_Jira_issue_with_brief": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('jiraBaseUrl')}/rest/api/2/issue",
              "headers": {
                "Content-Type": "application/json",
                "Authorization": "@parameters('jiraAuthHeader')"
              },
              "body": {
                "fields": {
                  "project": { "key": "@{parameters('jiraProjectKey')}" },
                  "issuetype": { "name": "Task" },
                  "summary": "Incident brief: @{triggerBody()?['title']} (@{triggerBody()?['incidentId']}, severity @{triggerBody()?['severity']})",
                  "description": "@{first(body('Get_incident_brief_message')?['data'])?['content']?[0]?['text']?['value']}"
                }
              }
            },
            "runAfter": {}
          }
        },
        "else": {
          "actions": {
            "Record_rejection_jira_incident_issue": {
              "type": "Compose",
              "inputs": {
                "outcome": "rejected_or_expired",
                "incidentId": "@{triggerBody()?['incidentId']}",
                "decision": "@{body('Wait_for_approval_jira_incident_issue')?['decision']}",
                "approver": "@{body('Wait_for_approval_jira_incident_issue')?['approver']}",
                "note": "No Jira issue was created for this incident brief."
              },
              "runAfter": {}
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}
