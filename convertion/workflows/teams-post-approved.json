{
  "_comment": "internal-comms (example skill) adapted: draft an internal communication (TPRM weekly 3P update, Cyber Forum digest, incident report per NIS2 Art. 23 / DORA Art. 19 fields) -> output-verifier -> human approval -> post to a Teams channel via Graph from the automation identity. Context gathering (Confluence/Jira/SharePoint/Defender/Teams read) happens inside the agent's read-only tools. Without approval nothing is posted.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "foundryEndpoint": {
        "type": "string",
        "defaultValue": "https://{foundry-account}.services.ai.azure.com/api/projects/{project-name}"
      },
      "apiVersion": {
        "type": "string",
        "defaultValue": "v1",
        "_comment": "GA agents / conversations / responses data plane (finding C1; the classic thread/run REST retires 2027-03-31). Bind to the FOUNDRY_API_VERSION app setting (setup/.env) so scripts and workflows pin the same version."
      },
      "internalCommsAgentName": {
        "type": "string",
        "defaultValue": "{internal-comms-agent-name}"
      },
      "internalCommsAgentVersion": {
        "type": "string",
        "defaultValue": "{internal-comms-agent-version}",
        "_comment": "Promoted agent version (build/agent-versions.json, C19)."
      },
      "verifierAgentName": {
        "type": "string",
        "defaultValue": "{output-verifier-agent-name}"
      },
      "verifierAgentVersion": {
        "type": "string",
        "defaultValue": "{output-verifier-agent-version}",
        "_comment": "Promoted verifier version (build/agent-versions.json, C19)."
      },
      "approvalWebhookUrl": {
        "type": "securestring",
        "defaultValue": "{human-approval-subscribe-endpoint}"
      }
    },
    "triggers": {
      "Post_requested": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "required": [
              "teamId",
              "channelId",
              "format",
              "brief",
              "requestedBy"
            ],
            "properties": {
              "teamId": {
                "type": "string"
              },
              "channelId": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "description": "tprm-weekly-3p | cyber-forum-digest | incident-report | leadership-update | faq"
              },
              "brief": {
                "type": "string"
              },
              "requestedBy": {
                "type": "string",
                "description": "UPN from the caller's token"
              }
            }
          }
        }
      }
    },
    "actions": {
      "Create_draft_conversation": {
        "_comment": "One conversation per requested post.",
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/conversations?api-version=@{parameters('apiVersion')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          },
          "body": {
            "metadata": {
              "owner": "@{triggerBody()?['requestedBy']}",
              "source": "teams-post",
              "runId": "@{workflow().run.name}"
            }
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {}
      },
      "Run_internal_comms_agent": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses?api-version=@{parameters('apiVersion')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          },
          "body": {
            "conversation": "@{body('Create_draft_conversation')?['id']}",
            "agent_reference": "@if(empty(parameters('internalCommsAgentVersion')), createObject('type','agent_reference','name',parameters('internalCommsAgentName')), createObject('type','agent_reference','name',parameters('internalCommsAgentName'),'version',parameters('internalCommsAgentVersion')))",
            "input": "Draft the following internal communication in ENX format '@{triggerBody()?['format']}' (agents/internal-comms_addendum.md): @{triggerBody()?['brief']}. Return the message text only, framed as DRAFT.",
            "background": true
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {
          "Create_draft_conversation": [
            "Succeeded"
          ]
        }
      },
      "Until_draft_completes": {
        "type": "Until",
        "expression": "@contains(createArray('completed','failed','incomplete','cancelled'), body('Get_draft_status')?['status'])",
        "limit": {
          "count": 40,
          "timeout": "PT20M"
        },
        "runAfter": {
          "Run_internal_comms_agent": [
            "Succeeded"
          ]
        },
        "actions": {
          "Delay_Get_draft_status": {
            "type": "Wait",
            "inputs": {
              "interval": {
                "count": 10,
                "unit": "Second"
              }
            },
            "runAfter": {}
          },
          "Get_draft_status": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses/@{body('Run_internal_comms_agent')?['id']}?api-version=@{parameters('apiVersion')}",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://ai.azure.com"
              }
            },
            "runAfter": {
              "Delay_Get_draft_status": [
                "Succeeded"
              ]
            }
          }
        }
      },
      "Get_draft": {
        "_comment": "Draft text is `output_text` of the response.",
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses/@{body('Run_internal_comms_agent')?['id']}?api-version=@{parameters('apiVersion')}",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          }
        },
        "runAfter": {
          "Until_draft_completes": [
            "Succeeded"
          ]
        }
      },
      "Create_verifier_conversation": {
        "_comment": "Separate conversation for the verifier turn - the draft is verified out of the producing agent's context (agents/verifier_instructions.md).",
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/conversations?api-version=@{parameters('apiVersion')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          },
          "body": {
            "metadata": {
              "source": "output-verifier",
              "runId": "@{workflow().run.name}"
            }
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {
          "Get_draft": [
            "Succeeded"
          ]
        }
      },
      "Run_output_verifier": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses?api-version=@{parameters('apiVersion')}",
          "headers": {
            "Content-Type": "application/json"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          },
          "body": {
            "conversation": "@{body('Create_verifier_conversation')?['id']}",
            "agent_reference": "@if(empty(parameters('verifierAgentVersion')), createObject('type','agent_reference','name',parameters('verifierAgentName')), createObject('type','agent_reference','name',parameters('verifierAgentName'),'version',parameters('verifierAgentVersion')))",
            "input": "Deliverable type: Internal communication (Teams post). Verify this draft per your charter: first line exactly 'VERDICT: PASS' or 'VERDICT: FAIL', then findings. Draft: @{coalesce(body('Get_draft')?['output_text'], last(body('Get_draft')?['output'])?['content'][0]?['text'], '')}",
            "background": true
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {
          "Create_verifier_conversation": [
            "Succeeded"
          ]
        }
      },
      "Until_verifier_completes": {
        "type": "Until",
        "expression": "@contains(createArray('completed','failed','incomplete','cancelled'), body('Get_verifier_status')?['status'])",
        "limit": {
          "count": 40,
          "timeout": "PT30M"
        },
        "runAfter": {
          "Run_output_verifier": [
            "Succeeded"
          ]
        },
        "actions": {
          "Delay_Get_verifier_status": {
            "type": "Wait",
            "inputs": {
              "interval": {
                "count": 10,
                "unit": "Second"
              }
            },
            "runAfter": {}
          },
          "Get_verifier_status": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses/@{body('Run_output_verifier')?['id']}?api-version=@{parameters('apiVersion')}",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://ai.azure.com"
              }
            },
            "runAfter": {
              "Delay_Get_verifier_status": [
                "Succeeded"
              ]
            }
          }
        }
      },
      "Get_verifier_verdict": {
        "_comment": "Verdict text is `output_text` of the verifier response.",
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('foundryEndpoint')}/openai/v1/responses/@{body('Run_output_verifier')?['id']}?api-version=@{parameters('apiVersion')}",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://ai.azure.com"
          }
        },
        "runAfter": {
          "Until_verifier_completes": [
            "Succeeded"
          ]
        }
      },
      "Verifier_passed": {
        "_comment": "Charter format (agents/verifier_instructions.md): first line 'VERDICT: PASS|FAIL'; bare 'PASS' tolerated.",
        "type": "Compose",
        "inputs": "@or(startsWith(trim(first(split(coalesce(body('Get_verifier_verdict')?['output_text'], last(body('Get_verifier_verdict')?['output'])?['content'][0]?['text'], ''), '\n'))), 'VERDICT: PASS'), equals(trim(first(split(coalesce(body('Get_verifier_verdict')?['output_text'], last(body('Get_verifier_verdict')?['output'])?['content'][0]?['text'], ''), '\n'))), 'PASS'))",
        "runAfter": {
          "Get_verifier_verdict": [
            "Succeeded"
          ]
        }
      },
      "Respond_accepted": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 202,
          "body": {
            "runId": "@{workflow().run.name}",
            "status": "@{if(outputs('Verifier_passed'),'DRAFT_PENDING_APPROVAL','VERIFIER_FAIL')}"
          }
        },
        "runAfter": {
          "Verifier_passed": [
            "Succeeded"
          ]
        }
      },
      "If_verifier_passed": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@outputs('Verifier_passed')",
                true
              ]
            }
          ]
        },
        "runAfter": {
          "Respond_accepted": [
            "Succeeded"
          ]
        },
        "actions": {
          "Wait_for_approval_teams_post": {
            "type": "HttpWebhook",
            "inputs": {
              "subscribe": {
                "method": "POST",
                "uri": "@parameters('approvalWebhookUrl')",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "callbackUrl": "@{listCallbackUrl()}",
                  "kind": "TEAMS_POST",
                  "correlationId": "@{workflow().run.name}",
                  "requestedBy": "@{triggerBody()?['requestedBy']}",
                  "subject": "Post to Teams channel @{triggerBody()?['channelId']} as the assurance automation account",
                  "targetSystem": "Microsoft Teams (Graph chatMessage)",
                  "draft": "@{coalesce(body('Get_draft')?['output_text'], last(body('Get_draft')?['output'])?['content'][0]?['text'], '')}",
                  "verifierVerdict": "@{coalesce(body('Get_verifier_verdict')?['output_text'], last(body('Get_verifier_verdict')?['output'])?['content'][0]?['text'], '')}"
                }
              },
              "unsubscribe": {}
            },
            "limit": {
              "timeout": "P3D"
            },
            "runAfter": {}
          },
          "Check_approval_decision_teams_post": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@toLower(coalesce(body('Wait_for_approval_teams_post')?['decision'],''))",
                    "approved"
                  ]
                }
              ]
            },
            "runAfter": {
              "Wait_for_approval_teams_post": [
                "Succeeded"
              ]
            },
            "actions": {
              "Post_channel_message": {
                "_comment": "Sending a message on someone's behalf is a submission of record (governance/HUMAN_APPROVAL.md). Posted from the Logic App identity (Graph ChannelMessage.Send / Teamwork.Migrate NOT used; application permission scoped to the assurance team only), never as the requester.",
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://graph.microsoft.com/v1.0/teams/@{triggerBody()?['teamId']}/channels/@{triggerBody()?['channelId']}/messages",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com"
                  },
                  "body": {
                    "body": {
                      "contentType": "html",
                      "content": "@{replace(coalesce(body('Get_draft')?['output_text'], last(body('Get_draft')?['output'])?['content'][0]?['text'], ''), '\n', '<br/>')}<br/><i>Approved by @{body('Wait_for_approval_teams_post')?['approver']}; drafted by the InfoSec Assurance assistant on request of @{triggerBody()?['requestedBy']}.</i>"
                    }
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Record_rejection_teams_post": {
                  "type": "Compose",
                  "inputs": {
                    "outcome": "rejected_or_expired",
                    "decision": "@{body('Wait_for_approval_teams_post')?['decision']}",
                    "note": "Nothing was posted to Teams."
                  },
                  "runAfter": {}
                }
              }
            }
          }
        },
        "else": {
          "actions": {}
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}