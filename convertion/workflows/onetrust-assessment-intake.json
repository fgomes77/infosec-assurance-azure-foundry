{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "foundryEndpoint": {
        "type": "string",
        "defaultValue": "https://{foundry-account}.services.ai.azure.com/api/projects/{project-name}"
      },
      "apiVersion": { "type": "string", "defaultValue": "{foundry-api-version}" },
      "dpiaAgentId": { "type": "string", "defaultValue": "{dpia-agent-id}" },
      "onetrustBaseUrl": { "type": "string", "defaultValue": "https://{onetrust-tenant}.onetrust.com" },
      "onetrustApiToken": { "type": "securestring", "defaultValue": "{onetrust-token-from-key-vault}" },
      "sharepointSiteId": { "type": "string", "defaultValue": "{sharepoint-site-id}" },
      "sharepointDrivePath": { "type": "string", "defaultValue": "/TPRM/DPIA-Reports" },
      "teamsWebhookUrl": { "type": "securestring", "defaultValue": "{teams-incoming-webhook-url}" },
      "approvalWebhookUrl": { "type": "securestring", "defaultValue": "" }
    },
    "triggers": {
      "Daily_recurrence": {
        "type": "Recurrence",
        "recurrence": { "frequency": "Day", "interval": 1, "schedule": { "hours": [ "6" ] } }
      }
    },
    "actions": {
      "Get_completed_assessments_since_last_run": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('onetrustBaseUrl')}/api/assessment/v2/assessments",
          "queries": {
            "status": "Completed",
            "completedFrom": "@{addDays(utcNow(), -1)}"
          },
          "headers": { "Authorization": "Bearer @{parameters('onetrustApiToken')}" }
        },
        "runAfter": {}
      },
      "For_each_completed_assessment": {
        "type": "Foreach",
        "foreach": "@body('Get_completed_assessments_since_last_run')?['content']",
        "runAfter": { "Get_completed_assessments_since_last_run": [ "Succeeded" ] },
        "actions": {
          "Run_dpia_agent_on_assessment": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('foundryEndpoint')}/threads/runs",
              "queries": { "api-version": "@parameters('apiVersion')" },
              "headers": { "Content-Type": "application/json" },
              "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" },
              "body": {
                "assistant_id": "@parameters('dpiaAgentId')",
                "thread": {
                  "messages": [
                    {
                      "role": "user",
                      "content": "Generate the InfoSec TPA (DPIA) report for OneTrust assessment @{items('For_each_completed_assessment')?['assessmentId']} (@{items('For_each_completed_assessment')?['name']}). Return the full report content."
                    }
                  ]
                }
              }
            },
            "runAfter": {}
          },
          "Wait_until_dpia_run_completes": {
            "type": "Until",
            "expression": "@not(equals(body('Poll_dpia_run_status')?['status'], 'in_progress'))",
            "limit": { "count": 60, "timeout": "PT30M" },
            "runAfter": { "Run_dpia_agent_on_assessment": [ "Succeeded" ] },
            "actions": {
              "Delay_before_poll": {
                "type": "Wait",
                "inputs": { "interval": { "count": 20, "unit": "Second" } },
                "runAfter": {}
              },
              "Poll_dpia_run_status": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{parameters('foundryEndpoint')}/threads/@{body('Run_dpia_agent_on_assessment')?['thread_id']}/runs/@{body('Run_dpia_agent_on_assessment')?['id']}",
                  "queries": { "api-version": "@parameters('apiVersion')" },
                  "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
                },
                "runAfter": { "Delay_before_poll": [ "Succeeded" ] }
              }
            }
          },
          "Get_dpia_report_message": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{parameters('foundryEndpoint')}/threads/@{body('Run_dpia_agent_on_assessment')?['thread_id']}/messages",
              "queries": { "api-version": "@parameters('apiVersion')", "order": "desc", "limit": "1" },
              "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
            },
            "runAfter": { "Wait_until_dpia_run_completes": [ "Succeeded" ] }
          },
          "Send_approval_request_dpia_report_upload": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@parameters('approvalWebhookUrl')",
              "headers": { "Content-Type": "application/json" },
              "body": {
                "subject": "DPIA report upload for OneTrust assessment @{items('For_each_completed_assessment')?['assessmentId']}",
                "targetSystem": "SharePoint (@{parameters('sharepointDrivePath')})",
                "draft": "@{first(body('Get_dpia_report_message')?['data'])?['content']?[0]?['text']?['value']}",
                "correlationId": "@{workflow().run.name}",
                "callback": "Approve or reject via the callback URL registered by the Wait_for_approval_dpia_report_upload step of this run."
              }
            },
            "runAfter": { "Get_dpia_report_message": [ "Succeeded" ] }
          },
          "Wait_for_approval_dpia_report_upload": {
            "type": "HttpWebhook",
            "inputs": {
              "subscribe": {
                "method": "POST",
                "uri": "@parameters('approvalWebhookUrl')",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "callbackUrl": "@{listCallbackUrl()}",
                  "correlationId": "@{workflow().run.name}",
                  "instruction": "POST {\"decision\":\"approved\"|\"rejected\",\"approver\":\"<upn>\"} to callbackUrl"
                }
              },
              "unsubscribe": {}
            },
            "limit": { "timeout": "P3D" },
            "runAfter": { "Send_approval_request_dpia_report_upload": [ "Succeeded" ] }
          },
          "Check_approval_decision_dpia_report_upload": {
            "type": "If",
            "expression": { "and": [ { "equals": [ "@body('Wait_for_approval_dpia_report_upload')?['decision']", "approved" ] } ] },
            "runAfter": { "Wait_for_approval_dpia_report_upload": [ "Succeeded" ] },
            "actions": {
              "Upload_report_to_SharePoint": {
                "type": "Http",
                "inputs": {
                  "method": "PUT",
                  "uri": "https://graph.microsoft.com/v1.0/sites/@{parameters('sharepointSiteId')}/drive/root:@{parameters('sharepointDrivePath')}/DPIA-@{items('For_each_completed_assessment')?['assessmentId']}.md:/content",
                  "headers": { "Content-Type": "text/markdown" },
                  "authentication": { "type": "ManagedServiceIdentity", "audience": "https://graph.microsoft.com" },
                  "body": "@{first(body('Get_dpia_report_message')?['data'])?['content']?[0]?['text']?['value']}"
                },
                "runAfter": {}
              },
              "Post_summary_to_Teams": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@parameters('teamsWebhookUrl')",
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "text": "DPIA report approved by @{body('Wait_for_approval_dpia_report_upload')?['approver']} and stored for OneTrust assessment @{items('For_each_completed_assessment')?['name']} (@{items('For_each_completed_assessment')?['assessmentId']}). SharePoint: @{body('Upload_report_to_SharePoint')?['webUrl']}"
                  }
                },
                "runAfter": { "Upload_report_to_SharePoint": [ "Succeeded" ] }
              }
            },
            "else": {
              "actions": {
                "Record_rejection_dpia_report_upload": {
                  "type": "Compose",
                  "inputs": {
                    "outcome": "rejected_or_expired",
                    "assessmentId": "@{items('For_each_completed_assessment')?['assessmentId']}",
                    "decision": "@{body('Wait_for_approval_dpia_report_upload')?['decision']}",
                    "approver": "@{body('Wait_for_approval_dpia_report_upload')?['approver']}",
                    "note": "DPIA report was NOT uploaded to SharePoint; no Teams summary sent."
                  },
                  "runAfter": {}
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}
