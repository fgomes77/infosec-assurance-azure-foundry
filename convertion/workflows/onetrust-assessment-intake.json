{
  "_comment": "Refactored: the Routine no longer runs the agent or writes to SharePoint itself. It only decides WHAT to request and hands over to the instantiated report-delivery pipeline, which enforces verifier -> human approval -> render -> Reports taxonomy via the delivery Function (single SharePoint writer). The Logic App identity needs NO Graph write permission. Requirement b: every OneTrust assessment completed since the last run -> dpia-dpo-report pipeline (DOCX under Reports/DPO/<Supplier>/<Service>/).",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "onetrustBaseUrl": {
        "type": "string",
        "defaultValue": "https://{onetrust-tenant}.onetrust.com"
      },
      "onetrustApiToken": {
        "type": "securestring",
        "defaultValue": "{onetrust-token-app-setting-bound-to-key-vault}"
      },
      "dpiaPipelineUrl": {
        "type": "securestring",
        "defaultValue": "{trigger-url-of-the-dpia-dpo-report-instance-of-report-delivery-pipeline}"
      },
      "teamsWebhookUrl": {
        "type": "securestring",
        "defaultValue": "{teams-incoming-webhook-url}"
      },
      "requestedBy": {
        "type": "string",
        "defaultValue": "routine:onetrust-assessment-intake"
      }
    },
    "triggers": {
      "Daily_recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "schedule": {
            "hours": [
              "6"
            ]
          }
        }
      }
    },
    "actions": {
      "Get_completed_assessments_since_last_run": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{parameters('onetrustBaseUrl')}/api/assessment/v2/assessments",
          "queries": {
            "status": "Completed",
            "completedFrom": "@{addDays(utcNow(), -1)}"
          },
          "headers": {
            "Authorization": "Bearer @{parameters('onetrustApiToken')}"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {}
      },
      "For_each_completed_assessment": {
        "type": "Foreach",
        "foreach": "@body('Get_completed_assessments_since_last_run')?['content']",
        "runAfter": {
          "Get_completed_assessments_since_last_run": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 2
          }
        },
        "actions": {
          "Resolve_supplier_and_service": {
            "_comment": "Supplier = the assessment's primary inventory (vendor) name; Service = the assessment name (the OT Infosec Form is raised per vendor service). Adjust the two paths if the tenant's OneTrust template uses other fields.",
            "type": "Compose",
            "inputs": {
              "supplierName": "@{coalesce(items('For_each_completed_assessment')?['primaryInventoryDetails']?['inventoryName'], items('For_each_completed_assessment')?['orgGroup']?['name'], 'Unknown-Supplier')}",
              "serviceName": "@{coalesce(items('For_each_completed_assessment')?['name'], items('For_each_completed_assessment')?['assessmentId'])}"
            },
            "runAfter": {}
          },
          "Request_dpia_report": {
            "_comment": "HttpWebhook: the pipeline answers 202 immediately and calls back here (callbackUrl) with STORED / REJECTED_BY_APPROVER / VERIFIER_FAIL once the verifier and the human approver have decided - days later if needed. P5D = pipeline approval expiry (P3D) + margin.",
            "type": "HttpWebhook",
            "inputs": {
              "subscribe": {
                "method": "POST",
                "uri": "@parameters('dpiaPipelineUrl')",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "supplierName": "@{outputs('Resolve_supplier_and_service')?['supplierName']}",
                  "serviceName": "@{outputs('Resolve_supplier_and_service')?['serviceName']}",
                  "requestText": "Generate the InfoSec TPA (DPIA) report for OneTrust assessment @{items('For_each_completed_assessment')?['assessmentId']} (@{items('For_each_completed_assessment')?['name']}) using the read-only OneTrust tool; emit the dpia JSON contract.",
                  "inputFileIds": [],
                  "requestedBy": "@{parameters('requestedBy')}",
                  "callbackUrl": "@{listCallbackUrl()}"
                }
              },
              "unsubscribe": {}
            },
            "limit": {
              "timeout": "P5D"
            },
            "runAfter": {
              "Resolve_supplier_and_service": [
                "Succeeded"
              ]
            }
          },
          "Record_outcome": {
            "type": "Compose",
            "inputs": {
              "assessmentId": "@{items('For_each_completed_assessment')?['assessmentId']}",
              "status": "@{body('Request_dpia_report')?['status']}",
              "webUrl": "@{body('Request_dpia_report')?['webUrl']}",
              "runId": "@{body('Request_dpia_report')?['runId']}",
              "note": "Storage, approval and the Teams notification happened inside the dpia-dpo-report pipeline."
            },
            "runAfter": {
              "Request_dpia_report": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}