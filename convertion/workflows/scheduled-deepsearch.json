{
  "_comment": "Refactored: the Routine no longer runs the agent or writes to SharePoint itself. It only decides WHAT to request and hands over to the instantiated report-delivery pipeline, which enforces verifier -> human approval -> render -> Reports taxonomy via the delivery Function (single SharePoint writer). The Logic App identity needs NO Graph write permission. Requirement a on a schedule: each watchlist supplier/service -> deepsearch-report pipeline (verified HTML dashboard under Reports/<Supplier>/<Service>/). The workflow keeps ONLY the low-score Jira gate: the score comes back in the pipeline callback (overallScore parsed from the verified HTML's data-overall-score attribute; empty = no gate, never inferred).",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "sharepointSiteId": {
        "type": "string",
        "defaultValue": "{sharepoint-site-id}"
      },
      "watchlistListId": {
        "type": "string",
        "defaultValue": "{supplier-watchlist-list-id}",
        "_comment": "List columns: SupplierName, SupplierDomain, ServiceName (added), Active (Yes/No). Read-only Graph permission (Sites.Selected read) is enough."
      },
      "deepsearchPipelineUrl": {
        "type": "securestring",
        "defaultValue": "{trigger-url-of-the-deepsearch-report-instance-of-report-delivery-pipeline}"
      },
      "scoreThreshold": {
        "type": "int",
        "defaultValue": 60
      },
      "jiraBaseUrl": {
        "type": "string",
        "defaultValue": "https://{jira-tenant}.atlassian.net"
      },
      "jiraAuthHeader": {
        "type": "securestring",
        "defaultValue": "{jira-auth-header-app-setting-bound-to-key-vault}",
        "_comment": "Bind to an app setting @Microsoft.KeyVault(SecretUri=...). Preferred: OAuth 2.0 (3LO) bearer for a service account; Basic API-token only as fallback."
      },
      "jiraProjectKey": {
        "type": "string",
        "defaultValue": "{jira-project-key}"
      },
      "approvalWebhookUrl": {
        "type": "securestring",
        "defaultValue": "{human-approval-subscribe-endpoint}"
      },
      "requestedBy": {
        "type": "string",
        "defaultValue": "routine:scheduled-deepsearch"
      }
    },
    "triggers": {
      "Weekly_recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Week",
          "interval": 1,
          "schedule": {
            "weekDays": [
              "Monday"
            ],
            "hours": [
              "5"
            ]
          }
        }
      }
    },
    "actions": {
      "Read_supplier_watchlist_from_SharePoint": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "https://graph.microsoft.com/v1.0/sites/@{parameters('sharepointSiteId')}/lists/@{parameters('watchlistListId')}/items",
          "queries": {
            "expand": "fields(select=SupplierName,SupplierDomain,ServiceName,Active)"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://graph.microsoft.com"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 4,
            "interval": "PT10S"
          }
        },
        "runAfter": {}
      },
      "For_each_watchlist_supplier": {
        "type": "Foreach",
        "foreach": "@body('Read_supplier_watchlist_from_SharePoint')?['value']",
        "runAfter": {
          "Read_supplier_watchlist_from_SharePoint": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 2
          }
        },
        "actions": {
          "If_active": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@toLower(string(coalesce(items('For_each_watchlist_supplier')?['fields']?['Active'], true)))",
                      "false"
                    ]
                  }
                }
              ]
            },
            "runAfter": {},
            "actions": {
              "Request_deepsearch_report": {
                "type": "HttpWebhook",
                "inputs": {
                  "subscribe": {
                    "method": "POST",
                    "uri": "@parameters('deepsearchPipelineUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "supplierName": "@{items('For_each_watchlist_supplier')?['fields']?['SupplierName']}",
                      "serviceName": "@{coalesce(items('For_each_watchlist_supplier')?['fields']?['ServiceName'], '_ALL-SERVICES')}",
                      "requestText": "Run DeepSearch on @{items('For_each_watchlist_supplier')?['fields']?['SupplierName']} (@{items('For_each_watchlist_supplier')?['fields']?['SupplierDomain']}). Emit the full single-file HTML dashboard.",
                      "inputFileIds": [],
                      "requestedBy": "@{parameters('requestedBy')}",
                      "callbackUrl": "@{listCallbackUrl()}"
                    }
                  },
                  "unsubscribe": {}
                },
                "limit": {
                  "timeout": "P5D"
                },
                "runAfter": {}
              },
              "If_stored_and_score_below_threshold": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@body('Request_deepsearch_report')?['status']",
                        "STORED"
                      ]
                    },
                    {
                      "not": {
                        "equals": [
                          "@coalesce(body('Request_deepsearch_report')?['overallScore'],'')",
                          ""
                        ]
                      }
                    },
                    {
                      "less": [
                        "@int(body('Request_deepsearch_report')?['overallScore'])",
                        "@parameters('scoreThreshold')"
                      ]
                    }
                  ]
                },
                "runAfter": {
                  "Request_deepsearch_report": [
                    "Succeeded"
                  ]
                },
                "actions": {
                  "Wait_for_approval_low_score_jira_ticket": {
                    "type": "HttpWebhook",
                    "inputs": {
                      "subscribe": {
                        "method": "POST",
                        "uri": "@parameters('approvalWebhookUrl')",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "callbackUrl": "@{listCallbackUrl()}",
                          "kind": "JIRA_CREATE",
                          "correlationId": "@{workflow().run.name}",
                          "requestedBy": "@{parameters('requestedBy')}",
                          "subject": "Jira ticket for low DeepSearch score @{body('Request_deepsearch_report')?['overallScore']} - @{items('For_each_watchlist_supplier')?['fields']?['SupplierName']}",
                          "targetSystem": "Jira project @{parameters('jiraProjectKey')}",
                          "draft": "Weekly DeepSearch scored @{items('For_each_watchlist_supplier')?['fields']?['SupplierName']} at @{body('Request_deepsearch_report')?['overallScore']} (threshold @{parameters('scoreThreshold')}). Dashboard: @{body('Request_deepsearch_report')?['webUrl']}"
                        }
                      },
                      "unsubscribe": {}
                    },
                    "limit": {
                      "timeout": "P3D"
                    },
                    "runAfter": {}
                  },
                  "Check_approval_decision_low_score_jira_ticket": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@toLower(coalesce(body('Wait_for_approval_low_score_jira_ticket')?['decision'],''))",
                            "approved"
                          ]
                        }
                      ]
                    },
                    "runAfter": {
                      "Wait_for_approval_low_score_jira_ticket": [
                        "Succeeded"
                      ]
                    },
                    "actions": {
                      "Create_Jira_ticket_for_low_score": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@{parameters('jiraBaseUrl')}/rest/api/2/issue",
                          "headers": {
                            "Content-Type": "application/json",
                            "Authorization": "@parameters('jiraAuthHeader')"
                          },
                          "body": {
                            "fields": {
                              "project": {
                                "key": "@{parameters('jiraProjectKey')}"
                              },
                              "issuetype": {
                                "name": "Task"
                              },
                              "summary": "DeepSearch low score @{body('Request_deepsearch_report')?['overallScore']} for @{items('For_each_watchlist_supplier')?['fields']?['SupplierName']}",
                              "description": "Weekly DeepSearch scored @{items('For_each_watchlist_supplier')?['fields']?['SupplierName']} at @{body('Request_deepsearch_report')?['overallScore']} (threshold @{parameters('scoreThreshold')}). Approved by @{body('Wait_for_approval_low_score_jira_ticket')?['approver']}. Dashboard: @{body('Request_deepsearch_report')?['webUrl']}"
                            }
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {
                        "Record_rejection_low_score_jira_ticket": {
                          "type": "Compose",
                          "inputs": {
                            "outcome": "rejected_or_expired",
                            "supplier": "@{items('For_each_watchlist_supplier')?['fields']?['SupplierName']}",
                            "decision": "@{body('Wait_for_approval_low_score_jira_ticket')?['decision']}",
                            "approver": "@{body('Wait_for_approval_low_score_jira_ticket')?['approver']}",
                            "note": "No Jira ticket was created for the low DeepSearch score."
                          },
                          "runAfter": {}
                        }
                      }
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Record_outcome": {
                      "type": "Compose",
                      "inputs": {
                        "supplier": "@{items('For_each_watchlist_supplier')?['fields']?['SupplierName']}",
                        "status": "@{body('Request_deepsearch_report')?['status']}",
                        "overallScore": "@{body('Request_deepsearch_report')?['overallScore']}",
                        "webUrl": "@{body('Request_deepsearch_report')?['webUrl']}",
                        "note": "Storage/approval/Teams handled by the deepsearch-report pipeline; no Jira gate (not stored, score missing, or score >= threshold)."
                      },
                      "runAfter": {}
                    }
                  }
                }
              }
            },
            "else": {
              "actions": {}
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}