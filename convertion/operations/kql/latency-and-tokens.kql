// ---------------------------------------------------------------------------
// latency-and-tokens.kql — run latency (p50/p95) and token consumption per agent
// Control: governance/MODEL_ROUTING.md rule 7 (monthly tier tuning) and
//          ARCHITECTURE.md metrics (latency and token cost per deliverable);
//          ISO 42001 A.6.2.6; ISO 27001:2022 A.8.6 (capacity management);
//          DORA Art. 9(2) (ICT capacity and performance).
// Scope:   Log Analytics workspace — AppDependencies (Foundry tracing spans;
//          GenAI semantic-convention attributes in Properties).
// Signal:  per agent/model over 24 h: agent runs, p50/p95 run duration, input and
//          output tokens, estimated cost at the per-tier list price placeholders.
// Alert:   rows > 0 when p95 run latency exceeds the budget or an agent exceeds its
//          daily token budget (alerts.bicep rule `latency-and-token-budget`,
//          severity 3). Budgets are tuned at the monthly cost review (RUNBOOK §2 M2).
// Dashboard: drop the final `where breach` line for the full per-agent table.
// ---------------------------------------------------------------------------
let lookback = 24h;
let p95LatencyBudgetMs = 300000;          // 5 min per run — reasoning-tier deliverables
let dailyTokenBudget   = 5000000;         // per agent per day; revisit monthly
// EUR per 1M tokens — placeholders, keep aligned with the current Azure price
// list AND with the deployments of record in integrations/registry.json
// `model_tiers._deployment_of_record`. The reasoning tier is o4-mini, not
// o3-mini (finding C4): a price map that names a model the platform does not
// run prices the most expensive tier at zero, so the cost breach never fires
// where it matters. `unpricedModel` below makes that failure visible instead.
let priceIn  = dynamic({"gpt-4o-mini": 0.15, "gpt-4o": 2.50, "o4-mini": 1.10});
let priceOut = dynamic({"gpt-4o-mini": 0.60, "gpt-4o": 10.00, "o4-mini": 4.40});
AppDependencies
| where TimeGenerated > ago(lookback)
| where isnotempty(Properties["gen_ai.agent.name"]) or isnotempty(Properties["gen_ai.request.model"])
| extend agentName = coalesce(tostring(Properties["gen_ai.agent.name"]), "(unattributed)"),
         model     = coalesce(tostring(Properties["gen_ai.request.model"]), "(unknown)"),
         inTok     = tolong(Properties["gen_ai.usage.input_tokens"]),
         outTok    = tolong(Properties["gen_ai.usage.output_tokens"]),
         isRun     = Name has "process_thread_run" or Name has "invoke_agent" or Name has "create_run",
         // sampling weight: 1 when nothing was sampled, n when this item
         // stands for n. Without it a sampled workspace under-reports the
         // token bill by the sampling ratio and the budget breach never fires.
         weight    = toreal(coalesce(ItemCount, 1))
| summarize runs         = toreal(sum(iff(isRun, weight, 0.0))),
            p50Ms        = percentile(iff(isRun, DurationMs, real(null)), 50),
            p95Ms        = percentile(iff(isRun, DurationMs, real(null)), 95),
            inputTokens  = sum(inTok * weight),
            outputTokens = sum(outTok * weight)
          by agentName, model
| extend totalTokens = inputTokens + outputTokens
| extend estCostEur = round((todouble(inputTokens)  / 1000000.0) * todouble(priceIn[model])
                          + (todouble(outputTokens) / 1000000.0) * todouble(priceOut[model]), 2)
| extend unpricedModel = isnull(priceIn[model]) or isnull(priceOut[model])
| extend breach = case(p95Ms > p95LatencyBudgetMs, "latency-p95",
                       totalTokens > dailyTokenBudget, "token-budget",
                       // a model the price map does not know is a breach of
                       // its own: its cost is invisible until someone adds it
                       unpricedModel and totalTokens > 0, "unpriced-model",
                       "")
| project agentName, model, runs = round(runs, 0),
          p50Ms = round(p50Ms, 0), p95Ms = round(p95Ms, 0),
          inputTokens = round(inputTokens, 0), outputTokens = round(outputTokens, 0),
          totalTokens = round(totalTokens, 0), estCostEur, breach
| where isnotempty(breach)
| order by totalTokens desc
