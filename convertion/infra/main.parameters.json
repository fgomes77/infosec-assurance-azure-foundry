    "chatModelFormat": { "value": "OpenAI" },
    "reasoningModelFormat": { "value": "OpenAI" },
    "lightModelFormat": { "value": "OpenAI" },
    "deploymentSku": { "value": "DataZoneStandard" },
    "enableWebSearch": { "value": true },

    "publicNetworkAccess": { "value": "Enabled" },
