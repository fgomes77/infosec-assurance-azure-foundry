// Token economy (MODEL_ROUTING rule 7): tokens per agent per deliverable, daily.
AppDependencies
| where TimeGenerated > ago(1d)
| where isnotempty(Properties["gen_ai.usage.input_tokens"])
| extend agent = tostring(Properties["gen_ai.agent.name"]),
         model = tostring(Properties["gen_ai.response.model"]),
         inTok = tolong(Properties["gen_ai.usage.input_tokens"]),
         outTok = tolong(Properties["gen_ai.usage.output_tokens"])
| summarize runs = dcount(OperationId), inputTokens = sum(inTok), outputTokens = sum(outTok) by agent, model
| extend tokensPerRun = (inputTokens + outputTokens) / runs
| order by tokensPerRun desc
